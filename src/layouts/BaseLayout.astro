---
import "../styles/global.css";
import TensegrityField from "../components/TensegrityField.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Public assets (public/) are never base-prefixed by Astro
// automatically — unlike import.meta.env.BASE_URL in frontmatter/HTML,
// a plain imported CSS file has no way to see the configured `base`.
// These paths are computed here once and used both for the favicon
// link and the @font-face block below, so both deploy correctly
// whether the site is served from "/" or a GitHub Pages project
// subpath like "/samarth_personal_website/".
const base = import.meta.env.BASE_URL;
const font = (file: string) => `${base}fonts/${file}`;

const fontFaceCSS = `
  @font-face { font-family: "Archivo"; font-style: normal; font-weight: 400; font-display: swap; src: url("${font("archivo-400.woff2")}") format("woff2"); }
  @font-face { font-family: "Archivo"; font-style: normal; font-weight: 500; font-display: swap; src: url("${font("archivo-500.woff2")}") format("woff2"); }
  @font-face { font-family: "Archivo"; font-style: normal; font-weight: 600; font-display: swap; src: url("${font("archivo-600.woff2")}") format("woff2"); }
  @font-face { font-family: "Archivo"; font-style: normal; font-weight: 700; font-display: swap; src: url("${font("archivo-700.woff2")}") format("woff2"); }
  @font-face { font-family: "Archivo"; font-style: normal; font-weight: 800; font-display: swap; src: url("${font("archivo-800.woff2")}") format("woff2"); }
  @font-face { font-family: "Space Mono"; font-style: normal; font-weight: 400; font-display: swap; src: url("${font("space-mono-400.woff2")}") format("woff2"); }
  @font-face { font-family: "Space Mono"; font-style: normal; font-weight: 700; font-display: swap; src: url("${font("space-mono-700.woff2")}") format("woff2"); }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Sets data-theme before first paint, so the page never flashes
      the wrong scheme: a stored manual choice wins, otherwise the
      visitor's system preference decides. Inline + is:inline so it
      runs as a classic blocking script, not a deferred module.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style set:html={fontFaceCSS}></style>
  </head>
  <body>
    <TensegrityField />
    <slot />
  </body>
</html>
